{   a : Int;
    b : Int = 5;
    {   proc f(x : Int, y : Int) {
            z : Int = x;
            return z + y;
        };
        a = f(1, b);
    };
    {   proc g(x : Bool, y : Bool) {
            x = x && y;
            proc h(z : Bool){
                a = 10 * 2;
                return z && y;
            };
            return h(x);
        };
    };
}