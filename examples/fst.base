{   a : Int = 5;
    b : Int = 10;
    {   proc f(x : Int, y : Int) {
            z : Int = x;
            return z + y;
        };
        c : Int = f(a, b);
        b = b + c;
    };
    c : Bool;
    {   proc g(x : Bool, y : Bool) {
            x = x && y;
            proc h(z : Bool){
                return z;
            };
            return h(x);
        };
        c = True && g(True, False);
    };
}